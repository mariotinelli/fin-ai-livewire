APP_NAME=""
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=
BOOST_RULES_ENABLED=true

# Browsershot: Node >=22.12 e Puppeteer do package-lock.json.
# Após npm ci --ignore-scripts, instale o Chrome com: npx puppeteer browsers install chrome
# Vazios: Node no PATH, Chrome gerenciado pelo Puppeteer, node_modules deste projeto
# e script browser.cjs do Browsershot. Use paths absolutos entre aspas para sobrescrever.
# Resolva Browsershot pelo container (app(Browsershot::class)) para aplicar esta configuração.
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NODE_MODULE_PATH=
BROWSERSHOT_BIN_PATH=

# Segredos externos de 16 a 72 bytes, exigidos somente para criar cada conta em produção/homolog.
PRODUCTION_ADMIN_PASSWORD=
PRODUCTION_SUPPORT_PASSWORD=

# Forward port for laravel sail
APP_PORT=
# Enable Laravel Sail
SAIL_ENABLED=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DISCORD_ALERTS_ENABLED=false
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_ALERT_TIMEOUT=3
DISCORD_ALERT_RETRY_TIMES=2
DISCORD_ALERT_RETRY_SLEEP_MS=200
DISCORD_ALERT_THROTTLE_SECONDS=60
DISCORD_ALERT_TRACE_LINES=12

# Instalações novas: PostgreSQL 16 com ICU, UTF-8 e pdo_pgsql no PHP do Herd.
# O usuário de migrations precisa provisionar citext (ou recebê-la já instalada).
# Bancos existentes exigem transferência e validação próprias; não basta trocar o driver.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# O driver log registra eventos no backend sem entregar atualizações ao navegador.
# Reverb, Pusher ou Ably exigem a dependência PHP do respectivo driver antes da ativação.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
# Opcional: ausente ou vazio mantém os nomes originais das filas em qualquer ambiente.
# Quando preenchido, use um identificador exclusivo da aplicação, sem espaços.
# APP_ENV é acrescentado automaticamente aos nomes das filas prefixadas.
QUEUE_PREFIX=

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
PARAMETER_STORE_PATH_QA=
PARAMETER_STORE_PATH_HML=
PARAMETER_STORE_PATH_PRODUCTION=

VITE_APP_NAME="${APP_NAME}"

LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK="local"
