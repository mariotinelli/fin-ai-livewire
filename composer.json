{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.382",
        "getbrevo/brevo-php": "^6.0",
        "intervention/image": "^4.0",
        "laravel/ai": "^1.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.29.0",
        "livewire/livewire": "^4.0",
        "maatwebsite/excel": "^4.0",
        "opcodesio/log-viewer": "^3.14",
        "owen-it/laravel-auditing": "^14.0",
        "predis/predis": "^3.0",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-sluggable": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/breeze": "^2.2",
        "laravel/pail": "^1.1",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.21.1",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-stressless": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-install-cmd": [
            "@php -r \"if (!file_exists('.env') && (!is_file('.env.example') || !@copy('.env.example', '.env'))) { fwrite(STDERR, 'Falha ao copiar .env: confira .env.example e permissões de escrita; corrija o problema e repita a instalação.'.PHP_EOL); exit(1); }\"",
            "@php -r \"if (!file_exists('.env.testing') && (!is_file('.env.testing.example') || !@copy('.env.testing.example', '.env.testing'))) { fwrite(STDERR, 'Falha ao copiar .env.testing: confira .env.testing.example e permissões de escrita; corrija o problema e repita a instalação.'.PHP_EOL); exit(1); }\""
        ],
        "post-root-package-install": [
            "@php -r \"if (!file_exists('.env') && (!is_file('.env.example') || !@copy('.env.example', '.env'))) { fwrite(STDERR, 'Falha ao copiar .env: confira .env.example e permissões de escrita; corrija o problema e repita a instalação.'.PHP_EOL); exit(1); }\"",
            "@php -r \"if (!file_exists('.env.testing') && (!is_file('.env.testing.example') || !@copy('.env.testing.example', '.env.testing'))) { fwrite(STDERR, 'Falha ao copiar .env.testing: confira .env.testing.example e permissões de escrita; corrija o problema e repita a instalação.'.PHP_EOL); exit(1); }\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --no-discover --no-interaction --ansi"
        ],
        "format": "php ./vendor/bin/pint --parallel",
        "format:check": "php ./vendor/bin/pint --parallel --test",
        "analyse": "php -d memory_limit=-1 ./vendor/bin/phpstan analyse --ansi --no-progress",
        "refactor": "php -d memory_limit=-1 ./vendor/bin/rector process --ansi",
        "refactor:check": "php -d memory_limit=-1 ./vendor/bin/rector process --ansi --dry-run",
        "test:focused": "php artisan test --compact --tia",
        "test:full": "php -d memory_limit=-1 ./vendor/bin/pest --parallel --tia --configuration=phpunit-ci.xml",
        "coverage:code": "php -d memory_limit=-1 ./vendor/bin/pest --tia --coverage --configuration=phpunit-ci.xml",
        "coverage:type": "php -d memory_limit=-1 ./vendor/bin/pest --tia --type-coverage --configuration=phpunit.xml",
        "frontend:build": "npm run build",
        "frontend:check": "node ./node_modules/prettier/bin/prettier.cjs --check resources/css",
        "audit:composer": "composer audit --locked --abandoned=fail",
        "audit:npm": "npm run audit",
        "quality:check": [
            "@frontend:build",
            "@frontend:check",
            "@test:full",
            "@test:js",
            "@audit:composer",
            "@audit:npm",
            "@format:check",
            "@analyse",
            "@refactor:check"
        ],
        "test:ci": "@quality:check",
        "test": "@quality:check",
        "test:js": "npm run test:js"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
